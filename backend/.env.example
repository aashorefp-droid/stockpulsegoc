# Copy to `.env` (gitignored) for local dev, or set these in the Render
# dashboard (Environment, sync:false) for production. NO real values here.
#
# IMPORTANT: any secret previously committed to git history must be ROTATED —
# moving it to env does not un-leak it.

# ── Alpaca (market data) ──
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Polygon (market data) ──
POLYGON_API_KEY=

# ── Telegram watchlist bot ──
WATCHLIST_BOT_TOKEN=
WATCHLIST_CHAT_ID=

# Telegram scheduler alerts/news digest bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner scheduled digests/snapshots
SCANNER_INCLUDE_NEWS=1
SCANNER_SNAPSHOT_ENABLED=1
SCANNER_SNAPSHOT_WATCHLISTS=default,momentum
SCANNER_SNAPSHOT_RETENTION_DAYS=10
SNAPSHOT_SCAN_MAX_WORKERS=4
SWEEP_DIGEST_ENABLED=1
HOLDINGS_SUMMARY_ENABLED=1
HOLDINGS_EMAIL_ENABLED=1
HOLDINGS_TELEGRAM_ENABLED=1
HOLDINGS_EMAIL_TO=
HOLDINGS_SCAN_MAX_WORKERS=5
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=              # defaults to GMAIL_USER
# SMTP_PASSWORD=          # defaults to GMAIL_APP_PASSWORD

# ── Gmail TOS-scan reader (Google account → Security → App passwords; needs 2FA) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Optional (safe defaults exist in config.py; override only if needed) ──
# ALPACA_DATA_BASE=https://data.alpaca.markets
# GMAIL_IMAP_HOST=imap.gmail.com
# TOS_EMAIL_FROM=thinkorswim.com
# TOS_EMAIL_SUBJECT=Alert: New symbol
# TOS_LOOKBACK_DAYS=2
# DATABASE_URL=            # cloud Postgres (Neon) — persists GEX streak history
